generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Dokumen {
  id                Int      @id @default(autoincrement())
  pendaftaranId     Int      @map("pendaftaran_id") // dari service-transaksi, bukan relasi FK Prisma (beda database)
  jenisDokumen      String   @db.VarChar(100) @map("jenis_dokumen")
  namaFileAsli      String   @db.VarChar(255) @map("nama_file_asli") // hanya untuk tampilan, tidak dipakai sebagai path disk
  namaFileTersimpan String   @db.VarChar(255) @map("nama_file_tersimpan") // uuid + ekstensi, nama fisik di disk
  mimeType          String   @db.VarChar(100) @map("mime_type")
  ukuranBytes       Int      @db.Integer @map("ukuran_bytes")
  uploadedBy        Int      @map("uploaded_by") // dari service RBAC
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([pendaftaranId])
  @@map("dokumen")
}